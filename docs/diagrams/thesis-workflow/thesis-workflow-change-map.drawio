erticalAlign=middle;fillColor=#E9F7EF;strokeColor=#31875A;strokeWidth=2;fontColor=#175239;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="55" y="1913" width="310" height="96" as="geometry"/></mxCell><mxCell id="stop" value="&lt;div style=&quot;font-size:19px&quot;&gt;&lt;b&gt;已实施｜保存检查点并停止&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-top:6px&quot;&gt;budget_exhausted / needs_evidence&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-top:6px&quot;&gt;no_safe_edit；不伪造通过&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF5E5;strokeColor=#D8A04A;strokeWidth=2;fontColor=#78551D;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="1080" y="2055" width="310" height="110" as="geometry"/></mxCell><mxCell id="bind" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;已实施｜Store / receipt 证明&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;绑定 report、evidence、输入/输出 ledger&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;原图 / PDF 页 / 转录与目视证明&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF5E5;strokeColor=#D8A04A;strokeWidth=2;fontColor=#78551D;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="500" y="2210" width="440" height="110" as="geometry"/></mxCell><mxCell id="candidate" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;已实施｜暂存档案与交付检查&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;仅写 host 选定路径；逐次核对 receipt&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;人工冲突保留，阻断不安全发布&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF5E5;strokeColor=#D8A04A;strokeWidth=2;fontColor=#78551D;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="500" y="2360" width="440" height="105" as="geometry"/></mxCell><mxCell id="gate" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;交付检查通过？&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;margin-top:6px&quot;&gt;沿用结构、参照等硬门&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EAF2FF;strokeColor=#547BD3;strokeWidth=2;fontColor=#173766;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="580" y="2505" width="280" height="110" as="geometry"/></mxCell><mxCell id="gate_repair" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;已实施｜硬门任务修复&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-top:6px&quot;&gt;报告修复进入同一轮次预算&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-top:6px&quot;&gt;纯档案 / PDF 重试不消耗语义轮数&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF5E5;strokeColor=#D8A04A;strokeWidth=2;fontColor=#78551D;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="1080" y="2475" width="310" height="140" as="geometry"/></mxCell><mxCell id="gate_stop" value="&lt;div style=&quot;font-size:19px&quot;&gt;&lt;b&gt;已实施｜交付失败恢复&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-top:6px&quot;&gt;保留候选版本、失败原因和待办&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-top:6px&quot;&gt;旧正式交付保持可用&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF5E5;strokeColor=#D8A04A;strokeWidth=2;fontColor=#78551D;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="55" y="2505" width="310" height="110" as="geometry"/></mxCell><mxCell id="publish" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;已实施｜host 提交档案 / PDF&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;同一快照与 receipt 授权&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;保留恢复日志与既有人工内容&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF5E5;strokeColor=#D8A04A;strokeWidth=2;fontColor=#78551D;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="500" y="2655" width="440" height="100" as="geometry"/></mxCell><mxCell id="done" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;交付报告、档案和运行记录&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=100;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EAF2FF;strokeColor=#547BD3;strokeWidth=2;fontColor=#173766;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="500" y="2920" width="440" height="70" as="geometry"/></mxCell><mxCell id="artifacts" value="&lt;div style=&quot;font-size:20px&quot;&gt;&lt;b&gt;后续建议｜研究交接清单&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;统一研究业务锚&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;固定编号关键发现&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;成稿前覆盖规划&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;本批仅实施审查与证据账本&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E9F7EF;strokeColor=#31875A;strokeWidth=2;fontColor=#175239;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="55" y="1305" width="310" height="220" as="geometry"/></mxCell><mxCell id="resume_rules" value="&lt;div style=&quot;font-size:20px&quot;&gt;&lt;b&gt;已实施｜恢复与纯只读审计&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;固定 attempt / cursor，补丁不重复&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;旧 v1 仅诊断，不自动导入&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;audit 不恢复缺失显示文件&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;保留任务、实际配置与 receipt&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF5E5;strokeColor=#D8A04A;strokeWidth=2;fontColor=#78551D;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="1080" y="1305" width="310" height="220" as="geometry"/></mxCell><mxCell id="fill_refs" value="&lt;div style=&quot;font-size:19px&quot;&gt;&lt;b&gt;后续建议｜补充外部参照&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;按尚未解决的比较需求补充&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;经营案例不能替代估值锚&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF5E5;strokeColor=#D8A04A;strokeWidth=2;fontColor=#78551D;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="500" y="1180" width="440" height="88" as="geometry"/></mxCell><mxCell id="data_preparation" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;保留｜准备并验证原始数据&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;首次研究缺数才抓取；续跑用冻结清单&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EAF2FF;strokeColor=#547BD3;strokeWidth=2;fontColor=#173766;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="500" y="268" width="440" height="88" as="geometry"/></mxCell><mxCell id="issue_tasks" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;已实施｜审查任务账本&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;稳定 RT ID、依据、位置与验收条件&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;阻断 / 披露限制 / 观察&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;host 应用 → 待复核 → 独立裁定&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E9F7EF;strokeColor=#31875A;strokeWidth=2;fontColor=#175239;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="500" y="1880" width="440" height="140" as="geometry"/></mxCell><mxCell id="pdf_conversion" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;保留｜核对正式 PDF&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;转换在暂存阶段完成；核对正式路径&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EAF2FF;strokeColor=#547BD3;strokeWidth=2;fontColor=#173766;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="500" y="2795" width="440" height="85" as="geometry"/></mxCell><mxCell id="legend_keep" value="&lt;div style=&quot;font-size:16px&quot;&gt;&lt;b&gt;蓝色：保留&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EAF2FF;strokeColor=#547BD3;strokeWidth=2;fontColor=#173766;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="350" y="122" width="190" height="32" as="geometry"/></mxCell><mxCell id="legend_change" value="&lt;div style=&quot;font-size:16px&quot;&gt;&lt;b&gt;橙色：修改&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF5E5;strokeColor=#D8A04A;strokeWidth=2;fontColor=#78551D;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="565" y="122" width="190" height="32" as="geometry"/></mxCell><mxCell id="legend_add" value="&lt;div style=&quot;font-size:16px&quot;&gt;&lt;b&gt;绿色：新增&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E9F7EF;strokeColor=#31875A;strokeWidth=2;fontColor=#175239;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="780" y="122" width="190" height="32" as="geometry"/></mxCell><mxCell id="task_boundary" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;本批已实施审查任务区&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-top:6px&quot;&gt;worker 只读，host 唯一应用&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-top:6px&quot;&gt;另一调用完整复核，不能自关&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-top:6px&quot;&gt;业务 / 同业 / 写作规划待后续&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E9F7EF;strokeColor=#31875A;strokeWidth=2;fontColor=#175239;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="1080" y="1855" width="310" height="145" as="geometry"/></mxCell><mxCell id="label_0" value="五路专题研究 → 各路完成后核查（受并发上限约束）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;resizable=1;connectable=0;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#56677F;fontColor=#56677F;fontSize=16;" vertex="1" parent="1"><mxGeometry x="48" y="774" width="610" height="37" as="geometry"/></mxCell><mxCell id="label_1" value="同业参照使用相同业务锚" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;resizable=1;connectable=0;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#56677F;fontColor=#34734F;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1100" y="770" width="290" height="37" as="geometry"/></mxCell><mxCell id="label_2" value="未通过，仍可修订&lt;br&gt;常规最多 2 轮" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;resizable=1;connectable=0;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#56677F;fontColor=#8C682D;fontSize=15;" vertex="1" parent="1"><mxGeometry x="372" y="2045" width="200" height="64" as="geometry"/></mxCell><mxCell id="label_3" value="阻断问题未解决，次数用尽" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;resizable=1;connectable=0;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#56677F;fontColor=#8C682D;fontSize=15;" vertex="1" parent="1"><mxGeometry x="866" y="2052" width="207" height="37" as="geometry"/></mxCell><mxCell id="label_4" value="通过" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;resizable=1;connectable=0;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#56677F;fontColor=#52725F;fontSize=15;" vertex="1" parent="1"><mxGeometry x="724" y="2167" width="90" height="37" as="geometry"/></mxCell><mxCell id="label_5" value="验证失败" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;resizable=1;connectable=0;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#56677F;fontColor=#8C682D;fontSize=15;" vertex="1" parent="1"><mxGeometry x="999" y="2211" width="200" height="37" as="geometry"/></mxCell><mxCell id="label_6" value="失败，尚可修复" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;resizable=1;connectable=0;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#56677F;fontColor=#8C682D;fontSize=15;" vertex="1" parent="1"><mxGeometry x="866" y="2492" width="205" height="37" as="geometry"/></mxCell><mxCell id="label_7" value="修复次数用尽" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;resizable=1;connectable=0;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#56677F;fontColor=#8C682D;fontSize=15;" vertex="1" parent="1"><mxGeometry x="373" y="2507" width="200" height="37" as="geometry"/></mxCell><mxCell id="label_8" value="全部通过" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;resizable=1;connectable=0;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#56677F;fontColor=#52725F;fontSize=15;" vertex="1" parent="1"><mxGeometry x="725" y="2615" width="150" height="37" as="geometry"/></mxCell><mxCell id="label_9" value="蓝色保留、橙色修改、绿色新增；“已实施”节点属于本批，“后续建议”节点尚未实施。&lt;br&gt;本批验证合成接口与恢复证明；未启动新股票研究，不以阶段数或页数证明研究质量。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;resizable=1;connectable=0;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#56677F;fontColor=#56677F;fontSize=16;" vertex="1" parent="1"><mxGeometry x="48" y="3040" width="1344" height="64" as="geometry"/></mxCell><mxCell id="label_10" value="已有候选 → 独立审查&lt;br&gt;后续建议节点当前跳过" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;resizable=1;connectable=0;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#56677F;fontColor=#173766;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1075" y="392" width="315" height="64" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>