px;margin-top:6px&quot;&gt;数字、条款、反证&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E9F7EF;strokeColor=#31875A;strokeWidth=2;fontColor=#175239;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="666" y="870" width="180" height="88" as="geometry"/></mxCell><mxCell id="research_4" value="&lt;div style=&quot;font-size:19px&quot;&gt;&lt;b&gt;战略驱动&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;投资、研发、增长&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EAF2FF;strokeColor=#547BD3;strokeWidth=2;fontColor=#173766;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="872" y="740" width="180" height="82" as="geometry"/></mxCell><mxCell id="check_4" value="&lt;div style=&quot;font-size:19px&quot;&gt;&lt;b&gt;本路核查&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-top:6px&quot;&gt;数字、条款、反证&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E9F7EF;strokeColor=#31875A;strokeWidth=2;fontColor=#175239;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="872" y="870" width="180" height="88" as="geometry"/></mxCell><mxCell id="benchmark" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;按业务、分部找参照&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;来源可回溯 ≠ 经济可比&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;经营案例与估值用途分开&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E9F7EF;strokeColor=#31875A;strokeWidth=2;fontColor=#175239;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="1100" y="740" width="290" height="218" as="geometry"/></mxCell><mxCell id="ledger" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;⑤ 整理证据和关键发现&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;原件、图片、核对转录建立关联&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;每项重要发现有固定编号与适用限制&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E9F7EF;strokeColor=#31875A;strokeWidth=2;fontColor=#175239;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="500" y="1185" width="440" height="125" as="geometry"/></mxCell><mxCell id="outline" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;⑥ 写作规划&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;安排重要发现进入哪一节，说明取舍&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E9F7EF;strokeColor=#31875A;strokeWidth=2;fontColor=#175239;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="500" y="1350" width="440" height="92" as="geometry"/></mxCell><mxCell id="write" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;⑦ 统一成稿（十二节）&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;完整底稿与关键清单形成同一套判断&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EAF2FF;strokeColor=#547BD3;strokeWidth=2;fontColor=#173766;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="500" y="1482" width="440" height="92" as="geometry"/></mxCell><mxCell id="review" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;⑧ 首次完整审查&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;读全证据，补齐并确定问题清单&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E9F7EF;strokeColor=#31875A;strokeWidth=2;fontColor=#175239;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="500" y="1615" width="440" height="100" as="geometry"/></mxCell><mxCell id="review_ok" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;审查通过？&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F1F4F8;strokeColor=#8B9BB2;strokeWidth=2;fontColor=#293D57;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="580" y="1755" width="280" height="110" as="geometry"/></mxCell><mxCell id="revision" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;按固定编号修订&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;保留证据限制与已正确内容&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;修订轮数和未决问题持续记录&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EAF2FF;strokeColor=#547BD3;strokeWidth=2;fontColor=#173766;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="55" y="1755" width="310" height="110" as="geometry"/></mxCell><mxCell id="recheck" value="&lt;div style=&quot;font-size:20px&quot;&gt;&lt;b&gt;定向复核 + 全文回归&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-top:6px&quot;&gt;检查旧问题；新增问题须记入清单&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E9F7EF;strokeColor=#31875A;strokeWidth=2;fontColor=#175239;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="55" y="1613" width="310" height="96" as="geometry"/></mxCell><mxCell id="stop" value="&lt;div style=&quot;font-size:20px&quot;&gt;&lt;b&gt;保持交付阻断&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-top:6px&quot;&gt;修订预算用尽或验证失败&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-top:6px&quot;&gt;保存问题与检查点，支持定向续修&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FDEDED;strokeColor=#C96565;strokeWidth=2;fontColor=#8A2929;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="1080" y="1755" width="310" height="110" as="geometry"/></mxCell><mxCell id="bind" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;⑨ 绑定并验证三个版本&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;报告 + 证据集 + 关键发现清单&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;图片引用通过已核对的文字转录校验&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E9F7EF;strokeColor=#31875A;strokeWidth=2;fontColor=#175239;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="500" y="1910" width="440" height="110" as="geometry"/></mxCell><mxCell id="candidate" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;⑩ 候选档案 + 交付程序检查&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;先写候选，保护人工内容与旧正式交付&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E9F7EF;strokeColor=#31875A;strokeWidth=2;fontColor=#175239;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="500" y="2060" width="440" height="105" as="geometry"/></mxCell><mxCell id="gate" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;交付检查通过？&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F1F4F8;strokeColor=#8B9BB2;strokeWidth=2;fontColor=#293D57;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="580" y="2205" width="280" height="110" as="geometry"/></mxCell><mxCell id="gate_repair" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;修复交付问题&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;重审受影响内容并重新绑定&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;保留重试次数与失败状态&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EAF2FF;strokeColor=#547BD3;strokeWidth=2;fontColor=#173766;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="1080" y="2175" width="310" height="140" as="geometry"/></mxCell><mxCell id="gate_stop" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;保存失败检查点&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;持续失败，保留候选与待办&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;旧正式报告和档案不被覆盖&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FDEDED;strokeColor=#C96565;strokeWidth=2;fontColor=#8A2929;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="55" y="2205" width="310" height="110" as="geometry"/></mxCell><mxCell id="publish" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;⑪ 提交档案并生成 PDF&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;正式交付对应同一套已通过的版本&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E9F7EF;strokeColor=#31875A;strokeWidth=2;fontColor=#175239;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="500" y="2355" width="440" height="100" as="geometry"/></mxCell><mxCell id="done" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;交付报告、档案和完整版本记录&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=100;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#234D80;strokeColor=#234D80;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="500" y="2495" width="440" height="70" as="geometry"/></mxCell><mxCell id="artifacts" value="&lt;div style=&quot;font-size:20px&quot;&gt;&lt;b&gt;新增交接产物&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;统一的研究业务锚&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;带原件关联的证据清单&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;固定编号的关键发现清单&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;逐项处理结果与未解决问题&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E9F7EF;strokeColor=#31875A;strokeWidth=2;fontColor=#175239;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="55" y="1185" width="310" height="220" as="geometry"/></mxCell><mxCell id="resume_rules" value="&lt;div style=&quot;font-size:20px&quot;&gt;&lt;b&gt;恢复与版本规则&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;记录每阶段输入和输出版本&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;只重做受影响的下游&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;保留每轮草稿与审查&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;从失败阶段继续处理&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E9F7EF;strokeColor=#31875A;strokeWidth=2;fontColor=#175239;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="1080" y="1185" width="310" height="220" as="geometry"/></mxCell><mxCell id="fill_refs" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;④ 按待解决需求补参照&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;区分经营比较、估值用途；缺失则明确保留&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E9F7EF;strokeColor=#31875A;strokeWidth=2;fontColor=#175239;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="500" y="1060" width="440" height="88" as="geometry"/></mxCell><mxCell id="label_0" value="五路专题研究 → 各路完成后核查（受并发上限约束）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;resizable=1;connectable=0;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#56677F;fontColor=#56677F;fontSize=16;" vertex="1" parent="1"><mxGeometry x="48" y="654" width="610" height="37" as="geometry"/></mxCell><mxCell id="label_1" value="同业参照使用相同业务锚" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;resizable=1;connectable=0;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#56677F;fontColor=#34734F;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1100" y="650" width="290" height="37" as="geometry"/></mxCell><mxCell id="label_2" value="未通过，仍可修订&lt;br&gt;常规最多 2 轮" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;resizable=1;connectable=0;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#56677F;fontColor=#8C682D;fontSize=15;" vertex="1" parent="1"><mxGeometry x="372" y="1745" width="200" height="64" as="geometry"/></mxCell><mxCell id="label_3" value="仍有重大问题，次数用尽" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;resizable=1;connectable=0;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#56677F;fontColor=#A84F4F;fontSize=15;" vertex="1" parent="1"><mxGeometry x="866" y="1752" width="207" height="37" as="geometry"/></mxCell><mxCell id="label_4" value="通过" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;resizable=1;connectable=0;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#56677F;fontColor=#52725F;fontSize=15;" vertex="1" parent="1"><mxGeometry x="724" y="1867" width="90" height="37" as="geometry"/></mxCell><mxCell id="label_5" value="验证失败" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;resizable=1;connectable=0;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#56677F;fontColor=#A84F4F;fontSize=15;" vertex="1" parent="1"><mxGeometry x="999" y="1911" width="200" height="37" as="geometry"/></mxCell><mxCell id="label_6" value="失败，尚可修复" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;resizable=1;connectable=0;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#56677F;fontColor=#8C682D;fontSize=15;" vertex="1" parent="1"><mxGeometry x="866" y="2192" width="205" height="37" as="geometry"/></mxCell><mxCell id="label_7" value="修复次数用尽" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;resizable=1;connectable=0;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#56677F;fontColor=#A84F4F;fontSize=15;" vertex="1" parent="1"><mxGeometry x="373" y="2207" width="200" height="37" as="geometry"/></mxCell><mxCell id="label_8" value="全部通过" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;resizable=1;connectable=0;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#56677F;fontColor=#52725F;fontSize=15;" vertex="1" parent="1"><mxGeometry x="725" y="2315" width="150" height="37" as="geometry"/></mxCell><mxCell id="label_9" value="绿色：新增或重做的交接；蓝色：保留的研究职责；红色：失败阻断。&lt;br&gt;这是建议方案，尚未实施；拆分步骤不等于每一步都必须增加一个新 agent。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;resizable=1;connectable=0;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#56677F;fontColor=#56677F;fontSize=17;" vertex="1" parent="1"><mxGeometry x="48" y="2615" width="1344" height="64" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>