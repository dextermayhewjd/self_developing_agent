=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6E819A;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fill_refs" target="ledger"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="start" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;输入股票代码、报告日&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;沿用现有技能入口与 Node 编排器&lt;/div&gt;" style="rounded=1;arcSize=100;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#234D80;strokeColor=#234D80;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="500" y="166" width="440" height="72" as="geometry"/></mxCell><mxCell id="freeze" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;① 冻结输入、检查恢复状态&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;原始数据、派生证据、阶段产物分开&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;根据版本只重做受影响的阶段&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E9F7EF;strokeColor=#31875A;strokeWidth=2;fontColor=#175239;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="500" y="268" width="440" height="100" as="geometry"/></mxCell><mxCell id="business" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;② 先识别本次研究的业务&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;分清旧业务、转型业务与价值依赖&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E9F7EF;strokeColor=#31875A;strokeWidth=2;fontColor=#175239;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="500" y="410" width="440" height="100" as="geometry"/></mxCell><mxCell id="anchor" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;③ 立疑并保存统一业务锚&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;明确研究范围、证据时期和待验证假设&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:6px&quot;&gt;后续阶段读取同一版本&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E9F7EF;strokeColor=#31875A;strokeWidth=2;fontColor=#175239;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="500" y="550" width="440" height="100" as="geometry"/></mxCell><mxCell id="research_0" value="&lt;div style=&quot;font-size:19px&quot;&gt;&lt;b&gt;财务排雷&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;利润、现金、负债&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EAF2FF;strokeColor=#547BD3;strokeWidth=2;fontColor=#173766;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="48" y="740" width="180" height="82" as="geometry"/></mxCell><mxCell id="check_0" value="&lt;div style=&quot;font-size:19px&quot;&gt;&lt;b&gt;本路核查&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-top:6px&quot;&gt;数字、条款、反证&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E9F7EF;strokeColor=#31875A;strokeWidth=2;fontColor=#175239;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="48" y="870" width="180" height="88" as="geometry"/></mxCell><mxCell id="research_1" value="&lt;div style=&quot;font-size:19px&quot;&gt;&lt;b&gt;尽调&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;股权、治理、关联&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EAF2FF;strokeColor=#547BD3;strokeWidth=2;fontColor=#173766;fontFamily=Noto Sans CJK SC;spacing=5;" vertex="1" parent="1"><mxGeometry x="254" y="740" width="180" height="82" as="geometry"/></mxCell><mxCell id="check_1" value="&lt;div style=&quot;font-size:19px&qu